+import { useEffect, useState } from "react";
+import { listen } from "@tauri-apps/api/event";
+import { getCurrentWebviewWindow } from "@tauri-apps/api/webviewWindow";
+import TrayPanel from "./TrayPanel";
+
+/** Keep only the visibility listener alive while the native panel is hidden. */
+export default function TrayHost() {
+  const [visible, setVisible] = useState(false);
+  useEffect(() => {
+    let active = true;
+    let revision = 0;
+    let stop: (() => void) | undefined;
+    const start = async () => {
+      try {
+        const unlisten = await listen<boolean>("codexbar:tray-visibility", ({ payload }) => {
+          if (!active) return;
+          revision++;
+          setVisible(payload);
+        });
+        if (!active) { unlisten(); return; }
+        stop = unlisten;
+        const observed = revision;
+        const current = await getCurrentWebviewWindow().isVisible();
+        if (active && revision === observed) setVisible(current);
+      } catch {
+        // A later native show event can recover without mounting a hidden dashboard.
+      }
+    };
+    void start();
+    return () => { active = false; stop?.(); };
+  }, []);
+  return visible ? <TrayPanel /> : null;
+}

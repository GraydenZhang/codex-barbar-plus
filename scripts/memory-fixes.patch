+vi.mock("@tauri-apps/api/event", () => ({ listen: (...args: unknown[]) => harness.listen(...args) }));
+vi.mock("@tauri-apps/api/webviewWindow", () => ({
+  getCurrentWebviewWindow: () => ({ isVisible: harness.isVisible }),
+}));
+vi.mock("./TrayPanel", () => ({ default: function Panel() {
+  useEffect(() => { harness.mount(); return harness.cleanup; }, []);
+  return <div>Live dashboard</div>;

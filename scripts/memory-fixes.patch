+import TrayHost from "./TrayHost";
+
+describe("TrayHost lifecycle", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    harness.callback = undefined;
+    harness.isVisible.mockResolvedValue(false);
+    harness.listen.mockImplementation(async (_: string, callback: typeof harness.callback) => {
+      harness.callback = callback;
+      return harness.stop;
+    });
+  });
+
+  it("does no dashboard work while hidden, unmounts on hide, and reloads on show", async () => {
+    const host = render(<TrayHost />);
+    await waitFor(() => expect(harness.isVisible).toHaveBeenCalledOnce());
+    expect(harness.mount).not.toHaveBeenCalled();
+    act(() => harness.callback?.({ payload: true }));
+    expect(screen.getByText("Live dashboard")).toBeInTheDocument();
+    act(() => harness.callback?.({ payload: false }));
+    expect(screen.queryByText("Live dashboard")).toBeNull();
+    expect(harness.cleanup).toHaveBeenCalledOnce();
+    act(() => harness.callback?.({ payload: true }));
+    expect(harness.mount).toHaveBeenCalledTimes(2);
+    host.unmount();
+    expect(harness.stop).toHaveBeenCalledOnce();
+    expect(harness.cleanup).toHaveBeenCalledTimes(2);
+  });
+
+  it("does not let a stale initial visibility response undo a newer hide event", async () => {
+    let resolve!: (visible: boolean) => void;
+    harness.isVisible.mockImplementation(() => new Promise<boolean>(done => { resolve = done; }));
+    render(<TrayHost />);
+    await waitFor(() => expect(harness.isVisible).toHaveBeenCalledOnce());
+    act(() => harness.callback?.({ payload: false }));
+    await act(async () => resolve(true));
+    expect(harness.mount).not.toHaveBeenCalled();
+  });
+
+  it("cleans up a listener whose registration finishes after unmount", async () => {
+    let resolve!: (stop: () => void) => void;
+    harness.listen.mockImplementation(() => new Promise<() => void>(done => { resolve = done; }));
+    const host = render(<TrayHost />);
+    host.unmount();
+    await act(async () => resolve(harness.stop));
+    expect(harness.stop).toHaveBeenCalledOnce();
+    expect(harness.isVisible).not.toHaveBeenCalled();
+  });
+});
